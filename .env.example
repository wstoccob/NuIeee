# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nuieee

# Auth - must be at least 32 characters (openssl rand -hex 32)
JWT_SECRET=change-me-use-openssl-rand-hex-32-to-generate-a-real-one
ACCESS_TOKEN_TTL_MINUTES=180

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=event-photos
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000
PRESIGNED_URL_TTL_SECONDS=3600
